<!-- DEPLOY TO: /var/ossec/etc/rules/local_rules.xml -->
<group name="capstone_orchestration,">

  <!-- Rule 100001: Mass File Modification (Ransomware Behavior) -->
  <!-- ENDPOINT THREAT: Mitigation via native agent process-kill, NOT firewall -->
  <rule id="100001" level="10">
    <if_sid>550, 554</if_sid>
    <match>.encrypted</match>
    <description>Heuristic Alert: Ransomware file extension (.encrypted) detected.</description>
  </rule>

  <!-- Rule 100010: Base Rule para sa UFW Blocks -->
  <rule id="100010" level="3">
    <if_sid>4100</if_sid>
    <match>[UFW BLOCK]</match>
    <description>UFW Firewall Block event caught.</description>
  </rule>

  <!-- Rule 100002: Internal Port Sweeping (Lateral Movement) -->
  <!-- PERIMETER THREAT: Mitigation via Sophos API block -->
  <rule id="100002" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>Heuristic Alert: Internal port sweeping or network scanning detected.</description>
  </rule>

  <!-- Rule 100011: Base Rule para sa Data Exfiltration metadata events -->
  <rule id="100011" level="3">
    <match>capstone_exfil_event</match>
    <description>Data exfiltration base telemetry event.</description>
  </rule>

  <!-- Rule 100003: Data Exfiltration Anomaly (Large Outbound Traffic) -->
  <!-- PERIMETER THREAT: Mitigation via Sophos API block -->
  <!-- Rule 4: Requires 3 exfil metadata events within 120 seconds to trigger -->
  <rule id="100003" level="10" frequency="3" timeframe="120">
    <if_matched_sid>100011</if_matched_sid>
    <same_source_ip />
    <description>Heuristic Alert: Potential data exfiltration to external IP address.</description>
  </rule>

  <!-- Rule 100012: Base Rule para sa Suspicious Process metadata events -->
  <rule id="100012" level="3">
    <match>capstone_susproc_event</match>
    <description>Suspicious process spawning base telemetry event.</description>
  </rule>

  <!-- Rule 100004: Suspicious Process Spawning (Living off the Land) -->
  <!-- ENDPOINT THREAT: Mitigation via native agent process-kill, NOT firewall -->
  <!-- Rule 4: Requires 2 suspicious process events within 30 seconds to trigger -->
  <rule id="100004" level="12" frequency="2" timeframe="30">
    <if_matched_sid>100012</if_matched_sid>
    <description>Heuristic Alert: Suspicious process spawning (Office application executing PowerShell).</description>
  </rule>

  <!-- Rule 100013: Base Rule para sa Resource Exhaustion metadata events -->
  <rule id="100013" level="3">
    <match>capstone_cryptojack_event</match>
    <description>Cryptojacking/resource exhaustion base telemetry event.</description>
  </rule>

  <!-- Rule 100005: Sustained Resource Exhaustion (Cryptojacking/C2) -->
  <!-- ENDPOINT THREAT: Mitigation via native agent process-kill, NOT firewall -->
  <!-- Rule 4: Requires 3 CPU exhaustion events within 60 seconds to trigger -->
  <rule id="100005" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100013</if_matched_sid>
    <description>Heuristic Alert: Sustained CPU/RAM resource exhaustion with external socket.</description>
  </rule>

  <!-- Rule 100014: Base Rule para sa Lateral Auth metadata events -->
  <rule id="100014" level="3">
    <match>capstone_lateralauth_event</match>
    <description>Lateral authentication base telemetry event.</description>
  </rule>

  <!-- Rule 100006: Impossible Travel / Pass-the-Hash Anomaly -->
  <!-- PERIMETER THREAT: Mitigation via Sophos API block -->
  <!-- Rule 4: Requires 5 rapid auth events within 120 seconds to trigger -->
  <rule id="100006" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100014</if_matched_sid>
    <same_source_ip />
    <description>Heuristic Alert: Rapid multi-server authentication or geo-velocity anomaly.</description>
  </rule>

</group>