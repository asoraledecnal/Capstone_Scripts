<!-- EXPLANATION: This gives Wazuh the ability to read Ubuntu firewall logs -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/syslog</location>
  </localfile>

<!-- EXPLANATION: This defines your Python SOAR script as an executable command (Network) -->
  <command>
    <name>wazuh-orchestrator</name>
    <executable>wazuh_orchestrator.py</executable>
    <timeout_allowed>yes</timeout_allowed>
  </command>
  
<!-- EXPLANATION: This defines the process-kill script for the native agent response (Endpoint) -->
  <command>
    <name>process-kill</name>
    <executable>process-kill</executable>
    <timeout_allowed>no</timeout_allowed>
  </command>

<!-- Tier 1: Temporary Block (Auto-Unblock for External SSH) -->
  <active-response>
    <command>wazuh-orchestrator</command>
    <location>server</location>
    <rules_id>5712</rules_id>
    <timeout>60</timeout>
  </active-response>

<!-- Tier 2: Permanent Quarantine via Perimeter Firewall (Manual SOC Unblock for Network Threats) -->
  <active-response>
    <command>wazuh-orchestrator</command>
    <location>server</location>
    <rules_id>100002,100003,100006</rules_id>
  </active-response>

<!-- Tier 3: Native Agent Execution (Process Kill for Endpoint Threats) -->
  <active-response>
    <command>process-kill</command>
    <location>local</location>
    <rules_id>100001,100004,100005</rules_id>
  </active-response>