<!-- EXPLANATION: Binibigyan nito ng kakayahan ang Wazuh na basahin ang Ubuntu firewall logs -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/syslog</location>
  </localfile>

<!-- EXPLANATION: Dine-define nito yung Python SOAR script mo bilang isang executable command -->
  <command>
    <name>wazuh-orchestrator</name>
    <executable>wazuh_orchestrator.py</executable>
    <timeout_allowed>yes</timeout_allowed>
  </command>

<!-- Tier 1: Temporary Block (Auto-Unblock for External SSH) -->
  <active-response>
    <command>wazuh-orchestrator</command>
    <location>server</location>
    <rules_id>5712</rules_id>
    <timeout>60</timeout>
  </active-response>

<!-- Tier 2: Permanent Quarantine (Manual SOC Unblock for Internal Threats) -->
  <active-response>
    <command>wazuh-orchestrator</command>
    <location>server</location>
    <rules_id>100001,100002,100003,100004,100005,100006</rules_id>
  </active-response>

  